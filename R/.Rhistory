## ============================================================================
## Example 2 of the paper (Beta, Normal, Beta) with unknown variance
##   y_i | theta, omega ~ N(theta, exp(omega)),   omega = log sigma^2
##   pi(theta) = Beta(1, 1),   pi(omega) = N(0, 10^2)
##   q(theta, omega) = Beta(alpha, beta) x N(m, s2)   (two mean-field blocks)
##
## ============================================================================
set.seed(123)
n <- 1000
y <- rnorm(n, mean = 0.6, sd = 1)
## N(theta, sigma^2), with constants
loglik <- function(theta) sum(dnorm(y, theta[1], exp(theta[2] / 2), log = TRUE))
families <- list(theta = fam_beta, omega = fam_mvnormal(1))
# Beta(1, 1) and N(0, 10^2)
priors   <- list(theta = fam_beta$eta(1, 1), omega = families$omega$eta(0, matrix(100)))
# start omega at N(0, 0.1), not at the default prior:
init     <- list(theta = fam_beta$eta(1, 1), omega = families$omega$eta(0, matrix(0.1)))
# Model
model <- qvmp_model(loglik, families)
# fit
t_fit   <- system.time(fit <- qvmp_fit(model, priors, init = init, rho = 0.8))
summary(fit)
## ============================================================================
## Example 2 of the paper (Beta, Normal, Beta) with unknown variance
##   y_i | theta, omega ~ N(theta, exp(omega)),   omega = log sigma^2
##   pi(theta) = Beta(1, 1),   pi(omega) = N(0, 10^2)
##   q(theta, omega) = Beta(alpha, beta) x N(m, s2)   (two mean-field blocks)
##
## ============================================================================
set.seed(123)
n <- 1000
y <- rnorm(n, mean = 0.6, sd = 1)
## N(theta, sigma^2), with constants
loglik <- function(theta) sum(dnorm(y, theta[1], exp(theta[2] / 2), log = TRUE))
families <- list(theta = fam_beta, omega = fam_mvnormal(1))
# Beta(1, 1) and N(0, 10^2)
priors   <- list(theta = fam_beta$eta(1, 1), omega = families$omega$eta(0, matrix(1)))
# Model
model <- qvmp_model(loglik, families)
# fit
t_fit   <- system.time(fit <- qvmp_fit(model, priors, init = init, rho = 0.8))
summary(fit)
